#ifndef ALL_OP
#define ALL_OP(name, tok, prec, isRight)
#endif

#ifndef BIN_OP
#define BIN_OP(name, tok, prec, isRight) ALL_OP(name, tok, prec, isRight)
#endif

#ifndef UN_OP
#define UN_OP(name, tok, prec, isRight) ALL_OP(name, tok, prec, isRight)
#endif

#ifdef BIN_OP
// Pointer-to-member, "->*", 95, /*left*/ true
// Pointer-to-member, ".*",  95, /*left*/ true
BIN_OP(Multiply, "*", 90, /*left*/ false)
BIN_OP(Divide, "/", 90, /*left*/ false)
BIN_OP(Remainder, "%", 90, /*left*/ false)
BIN_OP(Add, "+", 80, /*left*/ false)
BIN_OP(Subtract, "-", 80, /*left*/ false)
BIN_OP(ShiftLeft, "<<", 70, /*left*/ false)
BIN_OP(ShiftRight, ">>", 70, /*left*/ false)
BIN_OP(LessThan, "<", 60, /*left*/ false)
BIN_OP(GreaterThan, ">", 60, /*left*/ false)
BIN_OP(LessEqual, "<=", 60, /*left*/ false)
BIN_OP(GreaterEqual, ">=", 60, /*left*/ false)
BIN_OP(Equal, "==", 50, /*left*/ false)
BIN_OP(NotEqual, "!=", 50, /*left*/ false)
BIN_OP(BitAnd, "&", 40, /*left*/ false)
BIN_OP(BitXor, "^", 35, /*left*/ false)
BIN_OP(BitOr, "|", 30, /*left*/ false)
BIN_OP(LogicalAnd, "&&", 25, /*left*/ false)
BIN_OP(LogicalOr, "||", 20, /*left*/ false)
// Conditional, "?:", 15, /*right*/ true
// Assign, "=",    10, /*right*/ true
// Assign, "+=",   10, /*right*/ true
// Assign, "-=",   10, /*right*/ true
// Assign, "*=",   10, /*right*/ true
// Assign, "/=",   10, /*right*/ true
// Assign, "%=",   10, /*right*/ true
// Assign, "<<=",  10, /*right*/ true
// Assign, ">>=",  10, /*right*/ true
// Assign, "&=",   10, /*right*/ true
// Assign, "^=",   10, /*right*/ true
// Assign, "|=",   10, /*right*/ true
// Comma, ",",     5, /*left*/ true
#endif

// unary operator
#ifdef UN_OP
// Postfix call, "()",   110, /*left*/ true
// Postfix subscript, "[]", 110, /*left*/ true
// Member access, ".",   110, /*left*/ true
// Member access, "->",  110, /*left*/ true
UN_OP(Plus, "+", 100, /*right*/ true)
UN_OP(Minus, "-", 100, /*right*/ true)
UN_OP(LogicalNot, "!", 100, /*right*/ true)
UN_OP(BitwiseNot, "~", 100, /*right*/ true)
UN_OP(PreInc, "++", 100, /*right*/ true)
UN_OP(PreDec, "--", 100, /*right*/ true)
// C-style cast, "(type)", 100, /*right*/ true
// sizeof/alignof, "sizeof/alignof", 100, /*right*/ true
UN_OP(PostInc, "++", 110, /*left*/ false)
UN_OP(PostDec, "--", 110, /*left*/ false)
UN_OP(AddrOf, "&", 100, /*right*/ true)
UN_OP(Dereference, "*", 100, /*right*/ true)
#endif

#undef BIN_OP
#undef UN_OP
#undef ALL_OP