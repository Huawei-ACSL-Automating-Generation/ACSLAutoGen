#ifndef ALL_OP
#define ALL_OP(name, tok, prec, isRightAssoc)
#endif

#ifndef BIN_OP
#define BIN_OP(name, tok, prec, isRightAssoc) ALL_OP(name, tok, prec, isRightAssoc)
#endif

#ifndef UN_OP
#define UN_OP(name, tok, prec, isRightAssoc) ALL_OP(name, tok, prec, isRightAssoc)
#endif

#ifndef OTHER_OP
#define OTHER_OP(name, tok, prec, isRightAssoc) ALL_OP(name, tok, prec, isRightAssoc)
#endif

OTHER_OP(MemberAccessPointer, "->", 110, /*isRightAssoc*/ false)
OTHER_OP(MemberAccess, ".", 110, /*isRightAssoc*/ false)
BIN_OP(Multiply, "*", 90, /*isRightAssoc*/ false)
BIN_OP(Divide, "/", 90, /*isRightAssoc*/ false)
BIN_OP(Remainder, "%", 90, /*isRightAssoc*/ false)
BIN_OP(Add, "+", 80, /*isRightAssoc*/ false)
BIN_OP(Subtract, "-", 80, /*isRightAssoc*/ false)
BIN_OP(ShiftLeft, "<<", 70, /*isRightAssoc*/ false)
BIN_OP(ShiftRight, ">>", 70, /*isRightAssoc*/ false)
BIN_OP(LessThan, "<", 60, /*isRightAssoc*/ false)
BIN_OP(GreaterThan, ">", 60, /*isRightAssoc*/ false)
BIN_OP(LessEqual, "<=", 60, /*isRightAssoc*/ false)
BIN_OP(GreaterEqual, ">=", 60, /*isRightAssoc*/ false)
BIN_OP(Equal, "==", 50, /*isRightAssoc*/ false)
BIN_OP(NotEqual, "!=", 50, /*isRightAssoc*/ false)
BIN_OP(BitAnd, "&", 40, /*isRightAssoc*/ false)
BIN_OP(BitXor, "^", 35, /*isRightAssoc*/ false)
BIN_OP(BitOr, "|", 30, /*isRightAssoc*/ false)
BIN_OP(LogicalAnd, "&&", 25, /*isRightAssoc*/ false)
BIN_OP(LogicalOr, "||", 20, /*isRightAssoc*/ false)
OTHER_OP(Entailment, "==>", 15, /*isRightAssoc*/ true)
OTHER_OP(Equivalence, "<==>", 15, /*isRightAssoc*/ true)
OTHER_OP(Range, "..", 11, /*isRightAssoc*/ false)
OTHER_OP(Assign, "=", 10, /*isRightAssoc*/ true)
OTHER_OP(AddAssign, "+=", 10, /*isRightAssoc*/ true)
OTHER_OP(SubAssign, "-=", 10, /*isRightAssoc*/ true)
OTHER_OP(MulAssign, "*=", 10, /*isRightAssoc*/ true)
OTHER_OP(DivAssign, "/=", 10, /*isRightAssoc*/ true)
OTHER_OP(ModAssign, "%=", 10, /*isRightAssoc*/ true)
OTHER_OP(LeftShiftAssign, "<<=", 10, /*isRightAssoc*/ true)
OTHER_OP(RightShiftAssign, ">>=", 10, /*isRightAssoc*/ true)
OTHER_OP(BitANDAssign, "&=", 10, /*isRightAssoc*/ true)
OTHER_OP(BitXORAssign, "^=", 10, /*isRightAssoc*/ true)
OTHER_OP(BitORAssign, "|=", 10, /*isRightAssoc*/ true)
OTHER_OP(Comma, ",", 5, /*isRightAssoc*/ false)

// unary operator
OTHER_OP(Call, "()", 110, /*isRightAssoc*/ false)
OTHER_OP(Subscript, "[]", 110, /*isRightAssoc*/ false)
UN_OP(PostInc, "++", 110, /*isRightAssoc*/ false)
UN_OP(PostDec, "--", 110, /*isRightAssoc*/ false)
UN_OP(Plus, "+", 100, /*isRightAssoc*/ true)
UN_OP(Minus, "-", 100, /*isRightAssoc*/ true)
UN_OP(LogicalNot, "!", 100, /*isRightAssoc*/ true)
UN_OP(BitwiseNot, "~", 100, /*isRightAssoc*/ true)
UN_OP(PreInc, "++", 100, /*isRightAssoc*/ true)
UN_OP(PreDec, "--", 100, /*isRightAssoc*/ true)
UN_OP(AddrOf, "&", 100, /*isRightAssoc*/ true)
UN_OP(Dereference, "*", 100, /*isRightAssoc*/ true)

#undef BIN_OP
#undef UN_OP
#undef OTHER_OP
#undef ALL_OP