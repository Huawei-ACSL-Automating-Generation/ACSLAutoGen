# Doxygen configuration for ACSLG
PROJECT_NAME           = "ACSLG"
PROJECT_BRIEF          = "Automatic ACSL annotation generator"
PROJECT_NUMBER         = 0.1.0

OUTPUT_DIRECTORY       = docs/doxygen
OUTPUT_LANGUAGE        = English

INPUT                  = src tools README.md
FILE_PATTERNS          = *.h *.hh *.hpp *.c *.cc *.cpp *.cxx *.md
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

USE_MDFILE_AS_MAINPAGE = README.md
STRIP_FROM_PATH        = .
FULL_PATH_NAMES        = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCES_RELATION    = YES
REFERENCED_BY_RELATION = YES
SORT_BY_SCOPE_NAME     = YES
TAB_SIZE               = 2

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_PERLMOD       = NO

WARNINGS               = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_UNDOCUMENTED   = NO
QUIET                  = YES

HAVE_DOT               = YES
CLASS_DIAGRAMS         = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_NUM_THREADS        = 4
DOT_TRANSPARENT        = YES
